# Only needed for live-model runs (`callbench bench --model claude-opus-5`).
# Offline runs (`--model reference`) need no credentials and no network.
ANTHROPIC_API_KEY=

# Optional: override the effort level used for every agent role.
# One of: low | medium | high | xhigh | max
CALLBENCH_EFFORT=high

# Hard safety switch. When set to 1 (the default in code), the executor refuses
# to dispatch any tool whose side effect leaves the simulator. Never unset this
# unless you have replaced the simulator with a controlled test inbox and have
# read docs/METHODOLOGY.md.
CALLBENCH_SIMULATION_ONLY=1
